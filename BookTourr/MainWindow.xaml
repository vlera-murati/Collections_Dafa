<Window x:Class="BookTourr.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TourBooker"
        Height="850"
        Width="1300"
        MinHeight="650"
        MinWidth="1000"
        Background="#F3F6FA">

    <Window.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#243247"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#2457A7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D5DDE8"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="BorderBrush" Value="#D5DDE8"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="BorderBrush" Value="#D5DDE8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="6"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="BorderBrush" Value="#D5DDE8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#243247"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">

        <StackPanel Margin="24">

            <!-- HEADER -->
            <Border Background="White"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,0,18"
                    BorderBrush="#D5DDE8"
                    BorderThickness="1">

                <StackPanel>
                    <TextBlock Text="TourBooker"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#17365D"/>

                    <TextBlock Text="Manage countries, itineraries and bookings"
                               FontSize="14"
                               Foreground="#68778D"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- COUNTRY SEARCH -->
            <GroupBox Header="Country Search">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="CodeTextBox"
                             Height="35"
                             Margin="0,0,10,0"
                             ToolTip="Enter country code"/>

                    <Button Grid.Column="1"
                            Content="Search"
                            Click="SearchButton_Click"/>

                    <Button Grid.Column="2"
                            Content="Show All"
                            Background="#64748B"
                            Margin="0"
                            Click="ShowAllButton_Click"/>
                </Grid>
            </GroupBox>

            <!-- COUNTRIES AND ITINERARY -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ALL COUNTRIES -->
                <GroupBox Grid.Column="0"
                          Header="All Countries">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ListBox x:Name="CountriesListBox"
                                 MinHeight="220"
                                 Height="270"
                                 FontSize="14"/>

                        <Button Grid.Row="1"
                                Content="Add to Itinerary"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"
                                Click="btnAddToItinerar_Click"/>
                    </Grid>
                </GroupBox>

                <!-- ITINERARY BUILDER -->
                <GroupBox Grid.Column="2"
                          Header="Itinerary Builder">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ListBox x:Name="ItineraryListBox"
                                 MinHeight="180"
                                 Height="220"
                                 FontSize="14"/>

                        <WrapPanel Grid.Row="1"
                                   Margin="0,12,0,12">

                            <Button Content="Insert Before"
                                    Click="InsertBefore_Click"/>

                            <Button Content="Remove"
                                    Background="#C24141"
                                    Click="Remove_Click"/>

                            <Button Content="Undo"
                                    Background="#64748B"
                                    Margin="0"
                                    Click="btnUndo_Click"/>
                        </WrapPanel>

                        <TextBox Grid.Row="2"
                                 x:Name="tbxTourName"
                                 Height="38"
                                 Margin="0,0,0,10"
                                 ToolTip="Enter tour name"/>

                        <Button Grid.Row="3"
                                Content="Save Tour"
                                HorizontalAlignment="Left"
                                Margin="0"
                                Click="btnSaveTour_Click"/>
                    </Grid>
                </GroupBox>
            </Grid>

            <!-- BOOKING QUEUE -->
            <GroupBox Header="Booking Queue"
                      Margin="0,0,0,14">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Margin="0,0,12,0">

                        <TextBlock Text="Select Customer"
                                   Margin="0,0,0,6"/>

                        <ComboBox x:Name="CustomerComboBox"
                                  Margin="0,0,0,14"/>

                        <TextBlock Text="Select Country"
                                   Margin="0,0,0,6"/>

                        <ComboBox x:Name="TourComboBox"
                                  Margin="0,0,0,14"/>

                        <WrapPanel>
                            <Button Content="Add Booking"
                                    Click="AddBooking_Click"/>

                            <Button Content="Process Next"
                                    Background="#15803D"
                                    Margin="0"
                                    Click="ProcessNext_Click"/>
                        </WrapPanel>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#F3F6FA"
                            CornerRadius="6"
                            Padding="14"
                            Margin="0,0,12,0">

                        <StackPanel>
                            <TextBlock Text="Waiting bookings"
                                       Foreground="#68778D"/>

                            <TextBlock x:Name="QueueCountTextBlock"
                                       Text="Waiting bookings: 0"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Pending Requests"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <ListBox x:Name="BookingQueueListBox"
                                 Height="140"
                                 FontSize="14"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- HASHSET AND SORTEDSET -->
            <GroupBox Header="Explore HashSet and SortedSet">

                <StackPanel>

                    <TextBlock Text="Select saved tours to see the unique countries across their itineraries."
                               Foreground="#68778D"
                               Margin="0,0,0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- SAVED TOURS -->
                        <StackPanel Grid.Column="0"
                                    Margin="0,0,12,0">

                            <TextBlock Text="Saved Tours"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <ListBox x:Name="lbxToursToBoos"
                                     Height="190"
                                     SelectionMode="Multiple"
                                     DisplayMemberPath="Name"
                                     SelectionChanged="lbxToursToBoos_SelectionChanged"/>
                        </StackPanel>

                        <!-- SELECTED ITINERARIES -->
                        <StackPanel Grid.Column="1"
                                    Margin="0,0,12,0">

                            <TextBlock Text="Selected Tour Itineraries"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <TextBox x:Name="tbxToursItinerary"
                                     Height="190"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"/>
                        </StackPanel>

                        <!-- SORTEDSET RESULTS -->
                        <StackPanel Grid.Column="2">

                            <TextBlock Text="Unique Countries — SortedSet"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <ListBox x:Name="lbcCountriesSelection"
                                     Height="190"
                                     DisplayMemberPath="Name"/>
                        </StackPanel>
                    </Grid>

                   

                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</Window>
